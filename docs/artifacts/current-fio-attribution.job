# Supplemental fio attribution job comparing native, simple FUSE passthrough, and ScreenFS.
# Sized for quick local attribution; not claim-grade formal benchmark evidence.

[global]
ioengine=sync
direct=0
thread=1
numjobs=1
group_reporting=1
randrepeat=1
norandommap=0
refill_buffers=1
end_fsync=1

[seq_write_128k]
stonewall
filename=seq.dat
rw=write
bs=128k
size=16m

[seq_read_128k]
stonewall
filename=seq.dat
rw=read
bs=128k
size=16m

[rand_write_4k]
stonewall
filename=rand.dat
rw=randwrite
bs=4k
size=16m
runtime=3s
time_based=1

[rand_read_4k]
stonewall
filename=rand.dat
rw=randread
bs=4k
size=16m
runtime=3s
time_based=1

[sync_write_4k]
stonewall
filename=sync.dat
rw=write
bs=4k
size=4m
fsync=32
