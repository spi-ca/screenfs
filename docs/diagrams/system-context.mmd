flowchart LR
    pre["Mount preconditions\nnon-root + fusermount3\nio_uring required\nno fallback mount"] --> mount["holefs process\nFUSE3 + fractal-fuse 0.4.0"]
    host["Host filesystem\nsource_root\nexample: /"] --> mount

    subgraph policy["Runtime policy"]
        hide["hide rules\nexact / prefix / limited glob"]
        ro["selective readonly rules\nmatched mutation => EROFS"]
        impl["current implementation evidence\nglobal --readonly bool"]
        internal["internal hide rule\nmount-root recursion exclusion"]
    end

    hide --> mount
    ro --> mount
    impl -. current implementation only .-> ro
    internal --> mount

    mount --> view["Mounted virtual root\nexample: /tmp/holefs-root"]
    view --> sandbox["sandbox / chroot consumer\nsame host uid baseline"]
    sandbox -. supervisor boundary .-> sup["Upper supervisor responsibility\nchroot privilege + /proc,/sys,/dev,/run semantics"]

    mount -. hidden path access .-> enoent["ENOENT\nlooks absent"]
    mount -. visible write matched by readonly rule .-> erofs["EROFS"]
