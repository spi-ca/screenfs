flowchart LR
    pre["Mount preconditions\nnon-root + fusermount3\nio_uring required\nno fallback mount"] --> mount["screenfs process\nFUSE3 + fractal-fuse 0.4.0"]
    host["Host filesystem\nsource_root\nexample: /"] --> mount

    subgraph policy["Runtime policy"]
        hide["hide rules\nexact / prefix / limited glob"]
        family["mutability family\nselective-readonly | readonly-root-allowwrite\none family per mount"]
        config["policy source\nCLI mutability options\nor config mutability block"]
        internal["internal hide rule\nmount-root recursion exclusion"]
    end

    hide --> mount
    family --> mount
    config --> family
    internal --> mount

    mount --> view["Mounted virtual root\nexample: /tmp/screenfs-root"]
    view --> sandbox["sandbox / chroot consumer\nsame host uid baseline"]
    sandbox -. supervisor boundary .-> sup["Upper supervisor responsibility\nchroot privilege + /proc,/sys,/dev,/run semantics"]

    mount -. hidden path access .-> enoent["ENOENT\nlooks absent"]
    mount -. mutation blocked by family policy .-> erofs["EROFS"]
