    pre["Mount preconditions\nnon-root + fusermount3\nFUSE transport io_uring required\nno fallback mount"] --> mount["screenfs process\nFUSE3 + fractal-fuse 0.4.0"]
    host["Host filesystem\nsource_root\nexample: /"] --> mount

    subgraph policy["Runtime policy"]
        visibility["visibility axis\ndefault + hidden + visible\nbridge-visible ancestors"]
        mutability["mutability axis\ndefault + readonly + writable\nvisible-path mutation control"]
        config["policy source\nCLI axis options\nor config axis blocks"]
        internal["internal hidden rule\nmount-root recursion exclusion"]
