    sandbox -. supervisor boundary .-> sup["Upper supervisor responsibility\nchroot privilege + /proc,/sys,/dev,/run semantics"]

    mount -. hidden path access .-> enoent["ENOENT\nlooks absent"]
    mount -. blocked mutation .-> erofs["EROFS"]
